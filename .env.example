DATABASE_URL=postgresql://soravi:soravi@localhost:5432/soravi
REDIS_URL=redis://localhost:6379

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Ambiente
NODE_ENV=development

# API
PORT=3001
API_PORT=3001

# Frontend autorizado a acessar a API
CORS_ORIGIN=http://localhost:3000

# Autenticação
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_DAYS=30
PHONE_VERIFICATION_HMAC_SECRET=change-this-distinct-phone-verification-secret
PHONE_VERIFICATION_TTL_SECONDS=600
PHONE_VERIFICATION_MAX_ATTEMPTS=5
PHONE_VERIFICATION_COOLDOWN_SECONDS=60

# Entrega do OTP pela Meta WhatsApp Cloud API
PHONE_VERIFICATION_DELIVERY_PROVIDER=unavailable
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_GRAPH_API_VERSION=
META_WHATSAPP_OTP_TEMPLATE_NAME=
META_WHATSAPP_OTP_TEMPLATE_LANGUAGE=
META_WHATSAPP_HTTP_TIMEOUT_MS=5000

# Entrega de recuperação de senha por e-mail
PASSWORD_RESET_DELIVERY_PROVIDER=unavailable
RESEND_API_KEY=
PASSWORD_RESET_EMAIL_FROM=
FRONTEND_PUBLIC_URL=http://localhost:3000

# Distribuição de oportunidades
OPPORTUNITY_DISTRIBUTION_INTERVAL_MS=60000
OPPORTUNITY_DISTRIBUTION_BATCH_SIZE=50

# Processamento de elegibilidade do outbox
OUTBOUND_NOTIFICATION_INTERVAL_MS=60000
OUTBOUND_NOTIFICATION_BATCH_SIZE=25
