DATABASE_URL=postgresql://soravi:soravi@localhost:5432/soravi
REDIS_URL=redis://localhost:6379

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Ambiente
NODE_ENV=development

# API
PORT=3001
API_PORT=3001

# Frontend autorizado a acessar a API
CORS_ORIGIN=http://localhost:3000

# Autenticação
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_DAYS=30
PHONE_VERIFICATION_HMAC_SECRET=change-this-distinct-phone-verification-secret
