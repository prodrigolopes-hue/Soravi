generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  DEACTIVATED
}

enum Role {
  CUSTOMER
  PROFESSIONAL
  MODERATOR
  ADMIN
}

enum ProfessionalVerificationStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum LegalDocumentType {
  TERMS_OF_USE
  PRIVACY_POLICY
  COMMUNICATION_CONSENT
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

enum LaunchInterestType {
  CUSTOMER
  PROFESSIONAL
  BOTH
}

enum LaunchInterestSource {
  HOME
  INSTAGRAM
  WHATSAPP
  CAMPAIGN
  REFERRAL
  OTHER
}

enum PublicCategorySuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceRequestStatus {
  DRAFT
  OPEN
  RECEIVING_PROPOSALS
  IN_NEGOTIATION
  HIRED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  ACTIVE
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum EstimatedDurationUnit {
  HOUR
  DAY
  WEEK
  MONTH
}

enum ContractStatus {
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  BLOCKED
}

enum MessageStatus {
  SENT
  BLOCKED
  REMOVED
}

enum NotificationType {
  OPPORTUNITY_CREATED
  PROPOSAL_CREATED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String     @db.VarChar(120)
  email           String     @db.VarChar(254)
  emailNormalized String     @unique(map: "users_email_normalized_key") @map("email_normalized") @db.VarChar(254)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  phone           String?    @db.VarChar(32)
  phoneNormalized String?    @unique(map: "users_phone_normalized_key") @map("phone_normalized") @db.VarChar(32)
  status          UserStatus @default(PENDING)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  roles                             UserRole[]
  customerProfile                   CustomerProfile?
  professionalProfile               ProfessionalProfile?
  sessions                          AuthSession[]
  passwordResetTokens               PasswordResetToken[]
  emailVerificationTokens           EmailVerificationToken[]
  legalAcceptances                  LegalAcceptance[]
  reviewedCategoryRequests          CategoryRequest[]          @relation("CategoryRequestReviewer")
  reviewedPublicCategorySuggestions PublicCategorySuggestion[] @relation("PublicCategorySuggestionReviewer")
  messages                          Message[]
  conversationReadStates            ConversationReadState[]
  notifications                     Notification[]

  @@index([status, createdAt], map: "users_status_created_at_idx")
  @@index([createdAt], map: "users_created_at_idx")
  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role], map: "user_roles_user_id_role_key")
  @@index([role], map: "user_roles_role_idx")
  @@map("user_roles")
}

model CustomerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique(map: "customer_profiles_user_id_key") @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  contracts       Contract[]

  @@map("customer_profiles")
}

model ProfessionalProfile {
  id                     String                         @id @default(uuid()) @db.Uuid
  userId                 String                         @unique(map: "professional_profiles_user_id_key") @map("user_id") @db.Uuid
  displayName            String                         @map("display_name") @db.VarChar(120)
  bio                    String?                        @db.VarChar(1000)
  verificationStatus     ProfessionalVerificationStatus @default(NOT_STARTED) @map("verification_status")
  averageRating          Decimal                        @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount            Int                            @default(0) @map("review_count")
  servicesCompletedCount Int                            @default(0) @map("services_completed_count")
  isAvailable            Boolean                        @default(true) @map("is_available")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRequests       CategoryRequest[]
  professionalCategories ProfessionalCategory[]
  serviceOpportunities   ServiceOpportunity[]
  proposals              Proposal[]
  contracts              Contract[]

  @@index([verificationStatus], map: "professional_profiles_verification_status_idx")
  @@index([isAvailable], map: "professional_profiles_is_available_idx")
  @@index([averageRating], map: "professional_profiles_average_rating_idx")
  @@map("professional_profiles")
}

model LegalAcceptance {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  documentType    LegalDocumentType @map("document_type")
  documentVersion String            @map("document_version") @db.VarChar(32)
  acceptedAt      DateTime          @default(now()) @map("accepted_at") @db.Timestamptz(3)
  ipAddress       String?           @map("ip_address") @db.VarChar(45)
  userAgent       String?           @map("user_agent") @db.VarChar(512)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, documentType, documentVersion], map: "legal_acceptances_user_document_version_key")
  @@index([userId, acceptedAt], map: "legal_acceptances_user_accepted_at_idx")
  @@map("legal_acceptances")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "auth_sessions_user_expires_at_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@index([revokedAt], map: "auth_sessions_revoked_at_idx")
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "password_reset_tokens_user_created_at_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "email_verification_tokens_token_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "email_verification_tokens_user_created_at_idx")
  @@index([expiresAt], map: "email_verification_tokens_expires_at_idx")
  @@map("email_verification_tokens")
}

model Category {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(120)
  slug         String  @unique(map: "categories_slug_key") @db.VarChar(120)
  description  String? @db.VarChar(500)
  icon         String? @db.VarChar(64)
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  requests               CategoryRequest[]      @relation("CategoryRequestResolution")
  professionalCategories ProfessionalCategory[]
  serviceRequests        ServiceRequest[]

  @@index([isActive, displayOrder], map: "categories_active_display_order_idx")
  @@index([name], map: "categories_name_idx")
  @@map("categories")
}

model ServiceRequest {
  id                        String               @id @default(uuid()) @db.Uuid
  customerProfileId         String               @map("customer_profile_id") @db.Uuid
  categoryId                String               @map("category_id") @db.Uuid
  title                     String               @db.VarChar(160)
  description               String?              @db.VarChar(2000)
  status                    ServiceRequestStatus @default(OPEN)
  country                   String               @db.VarChar(2)
  state                     String               @db.VarChar(2)
  city                      String               @db.VarChar(120)
  neighborhood              String               @db.VarChar(120)
  postalCode                String               @map("postal_code") @db.VarChar(16)
  addressLine               String               @map("address_line") @db.VarChar(255)
  addressNumber             String               @map("address_number") @db.VarChar(32)
  addressComplement         String?              @map("address_complement") @db.VarChar(255)
  publishedAt               DateTime?            @map("published_at") @db.Timestamptz(3)
  hiredAt                   DateTime?            @map("hired_at") @db.Timestamptz(3)
  startedAt                 DateTime?            @map("started_at") @db.Timestamptz(3)
  completedAt               DateTime?            @map("completed_at") @db.Timestamptz(3)
  cancelledAt               DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason        String?              @map("cancellation_reason") @db.VarChar(1000)
  editableUntil             DateTime             @map("editable_until") @db.Timestamptz(3)
  opportunitiesDispatchedAt DateTime?            @map("opportunities_dispatched_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  customerProfile      CustomerProfile      @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  category             Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  files                ServiceRequestFile[]
  serviceOpportunities ServiceOpportunity[]
  proposals            Proposal[]
  contract             Contract?

  @@index([customerProfileId, status, createdAt], map: "service_requests_customer_status_created_at_idx")
  @@index([categoryId, status, createdAt], map: "service_requests_category_status_created_at_idx")
  @@index([status, createdAt], map: "service_requests_status_created_at_idx")
  @@map("service_requests")
}

model ServiceRequestFile {
  id               String   @id @default(uuid()) @db.Uuid
  serviceRequestId String   @map("service_request_id") @db.Uuid
  objectKey        String   @unique(map: "service_request_files_object_key_key") @map("object_key") @db.VarChar(1024)
  originalName     String   @map("original_name") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(127)
  sizeBytes        Int      @map("size_bytes")
  position         Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@unique([serviceRequestId, position], map: "service_request_files_service_request_id_position_key")
  @@map("service_request_files")
}

model ServiceOpportunity {
  id                    String    @id @default(uuid()) @db.Uuid
  serviceRequestId      String    @map("service_request_id") @db.Uuid
  professionalProfileId String    @map("professional_profile_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  viewedAt              DateTime? @map("viewed_at") @db.Timestamptz(3)

  serviceRequest      ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)

  @@unique([serviceRequestId, professionalProfileId], map: "service_opportunities_service_request_professional_key")
  @@index([professionalProfileId], map: "service_opportunities_professional_profile_id_idx")
  @@map("service_opportunities")
}

model Proposal {
  id                     String                @id @default(uuid()) @db.Uuid
  serviceRequestId       String                @map("service_request_id") @db.Uuid
  professionalProfileId  String                @map("professional_profile_id") @db.Uuid
  amountInCents          Int                   @map("amount_in_cents")
  estimatedDurationValue Int                   @map("estimated_duration_value")
  estimatedDurationUnit  EstimatedDurationUnit @map("estimated_duration_unit")
  message                String                @db.VarChar(2000)
  status                 ProposalStatus        @default(ACTIVE)
  submittedAt            DateTime              @default(now()) @map("submitted_at") @db.Timestamptz(3)
  acceptedAt             DateTime?             @map("accepted_at") @db.Timestamptz(3)
  rejectedAt             DateTime?             @map("rejected_at") @db.Timestamptz(3)
  withdrawnAt            DateTime?             @map("withdrawn_at") @db.Timestamptz(3)
  expiredAt              DateTime?             @map("expired_at") @db.Timestamptz(3)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceRequest      ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  contract            Contract?

  @@unique([serviceRequestId, professionalProfileId], map: "proposals_service_request_professional_key")
  @@index([serviceRequestId, status, createdAt], map: "proposals_service_request_status_created_at_idx")
  @@index([professionalProfileId, status, createdAt], map: "proposals_professional_profile_status_created_at_idx")
  @@map("proposals")
}

model Contract {
  id                    String                @id @default(uuid()) @db.Uuid
  serviceRequestId      String                @unique(map: "contracts_service_request_id_key") @map("service_request_id") @db.Uuid
  acceptedProposalId    String                @unique(map: "contracts_accepted_proposal_id_key") @map("accepted_proposal_id") @db.Uuid
  customerProfileId     String                @map("customer_profile_id") @db.Uuid
  professionalProfileId String                @map("professional_profile_id") @db.Uuid
  agreedAmountInCents   Int                   @map("agreed_amount_in_cents")
  agreedDurationValue   Int                   @map("agreed_duration_value")
  agreedDurationUnit    EstimatedDurationUnit @map("agreed_duration_unit")
  agreedMessage         String                @map("agreed_message") @db.VarChar(2000)
  status                ContractStatus        @default(ACCEPTED)
  acceptedAt            DateTime              @default(now()) @map("accepted_at") @db.Timestamptz(3)
  startedAt             DateTime?             @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?             @map("completed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason    String?               @map("cancellation_reason") @db.VarChar(1000)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceRequest      ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  acceptedProposal    Proposal            @relation(fields: [acceptedProposalId], references: [id], onDelete: Restrict)
  customerProfile     CustomerProfile     @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  conversation        Conversation?

  @@index([customerProfileId, status, createdAt], map: "contracts_customer_profile_status_created_at_idx")
  @@index([professionalProfileId, status, createdAt], map: "contracts_professional_profile_status_created_at_idx")
  @@map("contracts")
}

model Conversation {
  id         String             @id @default(uuid()) @db.Uuid
  contractId String             @unique(map: "conversations_contract_id_key") @map("contract_id") @db.Uuid
  status     ConversationStatus @default(ACTIVE)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt   DateTime?          @map("closed_at") @db.Timestamptz(3)

  contract   Contract                @relation(fields: [contractId], references: [id], onDelete: Restrict)
  messages   Message[]
  readStates ConversationReadState[]

  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  senderUserId   String        @map("sender_user_id") @db.Uuid
  content        String        @db.VarChar(4000)
  status         MessageStatus @default(SENT)
  sentAt         DateTime      @default(now()) @map("sent_at") @db.Timestamptz(3)
  editedAt       DateTime?     @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation            @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User                    @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  readStates   ConversationReadState[]

  @@index([conversationId, sentAt, id], map: "messages_conversation_sent_at_id_idx")
  @@index([senderUserId, sentAt], map: "messages_sender_sent_at_idx")
  @@map("messages")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  type         NotificationType
  title        String           @db.VarChar(160)
  message      String           @db.VarChar(500)
  resourceType String           @map("resource_type") @db.VarChar(64)
  resourceId   String           @map("resource_id") @db.Uuid
  readAt       DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, type, resourceType, resourceId], map: "notifications_user_type_resource_key")
  @@index([userId, readAt, createdAt], map: "notifications_user_read_at_created_at_idx")
  @@index([userId, type, createdAt], map: "notifications_user_type_created_at_idx")
  @@map("notifications")
}

model ConversationReadState {
  id                String   @id @default(uuid()) @db.Uuid
  conversationId    String   @map("conversation_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  lastReadMessageId String?  @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime @default(now()) @map("last_read_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastReadMessage Message?     @relation(fields: [lastReadMessageId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId], map: "conversation_read_states_conversation_user_key")
  @@index([lastReadMessageId], map: "conversation_read_states_last_read_message_idx")
  @@map("conversation_read_states")
}

model ProfessionalCategory {
  id                    String   @id @default(uuid()) @db.Uuid
  professionalProfileId String   @map("professional_profile_id") @db.Uuid
  categoryId            String   @map("category_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  category            Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([professionalProfileId, categoryId], map: "professional_categories_professional_profile_id_category_id_key")
  @@index([professionalProfileId], map: "professional_categories_professional_profile_id_idx")
  @@index([categoryId], map: "professional_categories_category_id_idx")
  @@map("professional_categories")
}

model CategoryRequest {
  id                      String                @id @default(uuid()) @db.Uuid
  professionalProfileId   String                @map("professional_profile_id") @db.Uuid
  suggestedName           String                @map("suggested_name") @db.VarChar(120)
  suggestedNameNormalized String                @map("suggested_name_normalized") @db.VarChar(120)
  description             String?               @db.VarChar(1000)
  status                  CategoryRequestStatus @default(PENDING)
  reviewNotes             String?               @map("review_notes") @db.VarChar(1000)
  resolvedCategoryId      String?               @map("resolved_category_id") @db.Uuid
  reviewedByUserId        String?               @map("reviewed_by_user_id") @db.Uuid
  reviewedAt              DateTime?             @map("reviewed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  resolvedCategory    Category?           @relation("CategoryRequestResolution", fields: [resolvedCategoryId], references: [id], onDelete: SetNull)
  reviewedByUser      User?               @relation("CategoryRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt], map: "category_requests_status_created_at_idx")
  @@index([professionalProfileId, status], map: "category_requests_professional_status_idx")
  @@index([suggestedNameNormalized, status], map: "category_requests_normalized_name_status_idx")
  @@index([resolvedCategoryId], map: "category_requests_resolved_category_idx")
  @@index([reviewedByUserId], map: "category_requests_reviewer_idx")
  @@map("category_requests")
}

model LaunchInterest {
  id                           String               @id @default(uuid()) @db.Uuid
  name                         String               @db.VarChar(120)
  email                        String               @db.VarChar(254)
  emailNormalized              String               @unique(map: "launch_interests_email_normalized_key") @map("email_normalized") @db.VarChar(254)
  phone                        String?              @db.VarChar(32)
  phoneNormalized              String?              @map("phone_normalized") @db.VarChar(32)
  audienceType                 LaunchInterestType
  city                         String               @db.VarChar(120)
  state                        String?              @db.VarChar(2)
  serviceInterest              String?              @map("service_interest") @db.VarChar(500)
  professionalCategoryInterest String?              @map("professional_category_interest") @db.VarChar(500)
  source                       LaunchInterestSource @default(HOME)

  privacyNoticeAcceptedAt DateTime  @map("privacy_notice_accepted_at") @db.Timestamptz(3)
  marketingConsentAt      DateTime? @map("marketing_consent_at") @db.Timestamptz(3)
  emailConfirmedAt        DateTime? @map("email_confirmed_at") @db.Timestamptz(3)
  unsubscribedAt          DateTime? @map("unsubscribed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([audienceType, createdAt], map: "launch_interests_audience_type_created_at_idx")
  @@index([city, state], map: "launch_interests_city_state_idx")
  @@index([source, createdAt], map: "launch_interests_source_created_at_idx")
  @@index([emailConfirmedAt], map: "launch_interests_email_confirmed_at_idx")
  @@index([unsubscribedAt], map: "launch_interests_unsubscribed_at_idx")
  @@map("launch_interests")
}

model PublicCategorySuggestion {
  id                      String                         @id @default(uuid()) @db.Uuid
  name                    String                         @db.VarChar(120)
  email                   String                         @db.VarChar(254)
  phone                   String?                        @db.VarChar(32)
  suggestedName           String                         @map("suggested_name") @db.VarChar(120)
  description             String?                        @db.VarChar(1000)
  status                  PublicCategorySuggestionStatus @default(PENDING)
  reviewNotes             String?                        @map("review_notes") @db.VarChar(1000)
  reviewedByUserId        String?                        @map("reviewed_by_user_id") @db.Uuid
  reviewedAt              DateTime?                      @map("reviewed_at") @db.Timestamptz(3)
  privacyNoticeAcceptedAt DateTime                       @map("privacy_notice_accepted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reviewedByUser User? @relation("PublicCategorySuggestionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt], map: "public_category_suggestions_status_created_at_idx")
  @@index([reviewedByUserId], map: "public_category_suggestions_reviewer_idx")
  @@map("public_category_suggestions")
}
